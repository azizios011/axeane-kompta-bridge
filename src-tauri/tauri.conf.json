{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Axeane Automation Bridge",
  "version": "1.1.0",
  "identifier": "com.axeane.kompta-bridge",
  "build": {
    "frontendDist": "frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Axeane Automation Bridge",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"]
  }
}
